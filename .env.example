# A replica set is mandatory for transactional operations (including local use).
MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
DB_NAME=gokulamyatras
# Generate at least 32 random characters. No fallback is accepted.
AUTH_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Explicitly opt in only for disposable development data. Both are blocked in production.
ENABLE_DEMO_SEED=false
ENABLE_MOCK_PAYMENTS=false

# Used only by `npm run create:staff`; do not put these into a deployed env file.
# STAFF_EMAIL=
# STAFF_PASSWORD=
# STAFF_NAME=
# STAFF_ROLE=ADMIN
